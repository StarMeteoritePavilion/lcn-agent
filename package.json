{
  "name": "lcn-agent",
  "version": "1.0.0",
  "description": "采用独立能力模块与顶层统一装配架构的 Agent 项目。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm test && npm run build",
    "pretest": "node scripts/clean.mjs .build/test && tsc -p tsconfig.test.json",
    "test": "cd .build/test && node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "openai": "^7.27.0",
    "partial-json": "^0.1.7",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarMeteoritePavilion/lcn-agent.git"
  },
  "bugs": {
    "url": "https://github.com/StarMeteoritePavilion/lcn-agent/issues"
  },
  "homepage": "https://github.com/StarMeteoritePavilion/lcn-agent#readme",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.9",
  "private": true
}
